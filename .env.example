# Yahoo, Binance archives, Kraken and Hyperliquid public data need no credentials.
# Dukascopy bulk access is currently blocked; see docs/DATA_SOURCES.md.
XASSET_DATA_DIR=./data
# Read by the Alpaca historical adapter. Set securely in the process environment.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Reserved for future provider adapters.
FRED_API_KEY=
EIA_API_KEY=
DATABENTO_API_KEY=
# Dashboard uses loopback by default. Remote binding requires this private token.
XASSET_DASHBOARD_TOKEN=
# Optional alert delivery; config/monitor.yaml defaults to log-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
